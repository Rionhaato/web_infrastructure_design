flowchart LR
    user[User Browser]
    dns[DNS<br/>www.foobar.com A record]
    lb[HAProxy Load Balancer<br/>Round Robin]

    subgraph s1[Server 1]
        nginx1[Nginx]
        app1[Application Server]
        code1[Codebase]
    end

    subgraph s2[Server 2]
        nginx2[Nginx]
        app2[Application Server]
        code2[Codebase]
    end

    primary[(Primary MySQL)]
    replica[(Replica MySQL)]

    user --> dns
    dns --> user
    user -->|HTTP request| lb
    lb --> nginx1
    lb --> nginx2
    nginx1 --> app1
    nginx2 --> app2
    app1 --> code1
    app2 --> code2
    app1 -->|Writes| primary
    app2 -->|Writes| primary
    app1 -->|Reads| replica
    app2 -->|Reads| replica
    primary -->|Replication| replica
